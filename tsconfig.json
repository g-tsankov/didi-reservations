{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/js/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "public/js/**/*.ts"]
}
