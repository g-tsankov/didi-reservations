{
  "name": "didi-classes",
  "private": true,
  "description": "Gym class reservation system on Cloudflare Pages + D1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 execute didi-classes --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute didi-classes --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
